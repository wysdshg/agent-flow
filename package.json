{
  "name": "agent-flow-mcp",
  "version": "0.1.0",
  "description": "A living flowchart for AI-coded projects: MCP server that lets your agent maintain a 7-state project flowchart (14 tools, auto-layout, zero-dependency HTML viewer)",
  "type": "module",
  "bin": {
    "agent-flow": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "skill",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx test/smoke.ts",
    "mcp": "node dist/index.js mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wysdshg/agent-flow.git"
  },
  "bugs": {
    "url": "https://github.com/wysdshg/agent-flow/issues"
  },
  "homepage": "https://wysdshg.github.io/agent-flow/demo.html",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "flowchart",
    "ai-agent",
    "claude-code",
    "cursor",
    "trae",
    "diagram",
    "visualization",
    "project-management",
    "dagre"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dagre": "^0.8.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
